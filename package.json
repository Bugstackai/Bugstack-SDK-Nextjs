{
  "name": "@bugstack/error-capture-sdk",
  "version": "0.1.0",
  "description": "Error capture SDK for Next.js API routes - automatically capture, report, and fix errors",
  "author": "",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "error-handling",
    "error-capture",
    "api-routes",
    "bugstack",
    "debugging",
    "monitoring",
    "app-router"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "next": "^14.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MasonBachmann7/BugStack.git",
    "directory": "packages/error-capture-sdk"
  },
  "bugs": {
    "url": "https://github.com/MasonBachmann7/BugStack/issues"
  },
  "homepage": "https://github.com/MasonBachmann7/BugStack/tree/main/packages/error-capture-sdk#readme"
}
