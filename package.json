{
  "name": "bugstack-sdk",
  "version": "2.4.0",
  "description": "The Bugstack SDK for Node.js and the browser. Reports uncaught and caught-and-logged server errors from Next.js, Express and any Node process, and, from the browser, errors, failed requests and opt-in frustration signals (rage, dead and error clicks, abandoned forms) to Bugstack, autonomous software maintenance.",
  "author": "",
  "license": "MIT",
  "keywords": [
    "bugstack",
    "autonomous-software-maintenance",
    "software-maintenance",
    "error-reporting",
    "error-capture",
    "nextjs",
    "app-router",
    "api-routes",
    "express",
    "nodejs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/nextjs/index.d.ts",
      "import": "./dist/adapters/nextjs/index.mjs",
      "require": "./dist/adapters/nextjs/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.mjs",
      "require": "./dist/browser/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.mjs",
      "require": "./dist/adapters/express/index.js"
    },
    "./generic": {
      "types": "./dist/adapters/generic/index.d.ts",
      "import": "./dist/adapters/generic/index.mjs",
      "require": "./dist/adapters/generic/index.js"
    },
    "./build": {
      "types": "./dist/build/upload.d.ts",
      "import": "./dist/build/upload.mjs",
      "require": "./dist/build/upload.js"
    },
    "./next-config": {
      "types": "./dist/next-config/index.d.ts",
      "import": "./dist/next-config/index.mjs",
      "require": "./dist/next-config/index.js"
    }
  },
  "bin": {
    "bugstack": "bin/bugstack.cjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "express": "^4.22.1",
    "happy-dom": "^21.0.4",
    "next": "15.5.15",
    "pino": "^9.14.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bugstackai/Bugstack-SDK-Nextjs.git"
  },
  "bugs": {
    "url": "https://github.com/Bugstackai/Bugstack-SDK-Nextjs/issues"
  },
  "homepage": "https://bugstack.ai"
}
