{
  "name": "bugstack-sdk",
  "version": "2.0.1",
  "description": "Framework-agnostic error capture SDK with adapters for Next.js, Express, and more - automatically capture, report, and fix errors",
  "author": "",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "express",
    "error-handling",
    "error-capture",
    "api-routes",
    "bugstack",
    "debugging",
    "monitoring",
    "app-router",
    "autonomous",
    "ai-powered"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/adapters/nextjs/index.d.ts",
      "import": "./dist/adapters/nextjs/index.mjs",
      "require": "./dist/adapters/nextjs/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.mjs",
      "require": "./dist/adapters/express/index.js"
    },
    "./generic": {
      "types": "./dist/adapters/generic/index.d.ts",
      "import": "./dist/adapters/generic/index.mjs",
      "require": "./dist/adapters/generic/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "express": "^4.18.2",
    "next": "^14.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MasonBachmann7/BugStack.git",
    "directory": "packages/error-capture-sdk"
  },
  "bugs": {
    "url": "https://github.com/MasonBachmann7/BugStack/issues"
  },
  "homepage": "https://github.com/MasonBachmann7/BugStack/tree/main/packages/error-capture-sdk#readme"
}
