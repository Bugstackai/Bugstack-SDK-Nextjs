{
  "name": "bugstack-sdk",
  "version": "1.0.0",
  "description": "AI-powered error capture SDK for Next.js API routes. Automatically captures errors and creates PRs with fixes using Claude.",
  "author": "Mason Bachmann",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "error-handling",
    "error-capture",
    "api-routes",
    "bugstack",
    "debugging",
    "monitoring",
    "app-router",
    "ai",
    "bug-fixing",
    "error-tracking",
    "claude",
    "automatic-fixes"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "next": "^14.0.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MasonBachmann7/BugStack.git",
    "directory": "packages/error-capture-sdk"
  },
  "bugs": {
    "url": "https://github.com/MasonBachmann7/BugStack/issues"
  },
  "homepage": "https://www.bugstack.ai"
}
